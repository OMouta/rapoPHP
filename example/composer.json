{
    "name": "app/example",
    "description": "Example App for RapoPHP",
    "require": {
        "php": ">=8.0",
        "rapo/framework": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../framework",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    }
}
